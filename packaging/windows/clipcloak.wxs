<?xml version="1.0" encoding="utf-8"?>
<!--
  Windows installer (WiX Toolset 5 + UI extension). Built in CI, see .gitlab-ci.yml (build:windows):

    wix extension add WixToolset.UI.wixext/5.0.2
    wix build packaging\windows\clipcloak.wxs -arch x64 -ext WixToolset.UI.wixext
        -d Version=1.2.3 -d AppDir=<abs>\dist\clipcloak -d NerDir=<abs>\dist\clipcloak-ner
        -d Icon=<abs>\clipcloak\resources\icon.ico -d LicenseRtf=<abs>\dist\license.rtf
        -o clipcloak-v1.2.3-windows-x86_64.msi

  Per-machine installation to "C:\Program Files\ClipCloak" (program in the folder,
  NER plugin in "ner\"). Interactive setup: welcome, license, feature selection
  (program, NER plugin, autostart, desktop shortcut, install folder), install.

  Silent installation, e.g. for GPO, ESET PROTECT, baramundi:
    msiexec /i clipcloak-v1.2.3-windows-x86_64.msi /qn
    msiexec /i clipcloak-v1.2.3-windows-x86_64.msi /qn AUTOSTART=0 DESKTOPSHORTCUT=1
    msiexec /i clipcloak-v1.2.3-windows-x86_64.msi /qn ADDLOCAL=Main,Autostart   (without NER)
    msiexec /x clipcloak-v1.2.3-windows-x86_64.msi /qn

  Features: Main (always), NER (on), Autostart (on; off with AUTOSTART=0),
            DesktopShortcut (off; on with DESKTOPSHORTCUT=1)
  A newer version replaces an older one (major upgrade, same UpgradeCode) and keeps
  the feature selection of the installed version.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="ClipCloak"
           Manufacturer="it-an-der-bar"
           Version="$(var.Version)"
           UpgradeCode="F6A0337E-BD8E-448C-AEFF-A1E4D06678B7"
           Scope="perMachine"
           Compressed="yes">
    <SummaryInformation Description="ClipCloak - redact, anonymise or pseudonymise clipboard contents" />
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="AppIcon" SourceFile="$(var.Icon)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/it-an-der-bar/ClipCloak" />
    <Property Id="ARPHELPLINK" Value="https://github.com/it-an-der-bar/ClipCloak" />
    <Property Id="AUTOSTART" Value="1" Secure="yes" />
    <Property Id="DESKTOPSHORTCUT" Value="0" Secure="yes" />

    <ui:WixUI Id="WixUI_FeatureTree" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="ClipCloak">
        <Directory Id="NERFOLDER" Name="ner" />

        <Component Id="InstallInfo" Guid="B1D6E12C-838E-43FC-8051-CAF6540260BF">
          <RegistryValue Root="HKLM" Key="Software\it-an-der-bar\ClipCloak" Name="InstallDir"
                         Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
          <RegistryValue Root="HKLM" Key="Software\it-an-der-bar\ClipCloak" Name="Version"
                         Type="string" Value="$(var.Version)" />
        </Component>

        <Component Id="Autostart" Guid="090879F5-C7E5-46EE-8207-BB744EC70456">
          <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="clipcloak"
                         Type="string" Value="&quot;[INSTALLFOLDER]clipcloak.exe&quot;" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- %ProgramData%\clipcloak for policy.yaml / defaults.yaml: only administrators and SYSTEM
         may write (ProgramData lets every user create files, which would let one user enforce
         settings for all). Protected ACL: SYSTEM + Administrators full, Users read. -->
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="POLICYFOLDER" Name="clipcloak">
        <Component Id="PolicyFolder" Guid="3C0E6B52-7B7D-4B0B-9C87-5D2E1A0F4E61">
          <CreateFolder>
            <PermissionEx Sddl="O:BAG:SYD:PAI(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;0x1200a9;;;BU)" />
          </CreateFolder>
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="F04D7A70-518B-43A7-A442-8AE535B6D55C">
        <Shortcut Id="StartMenuShortcut" Name="ClipCloak"
                  Description="Redact, anonymise or pseudonymise clipboard contents"
                  Target="[INSTALLFOLDER]clipcloak.exe" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKLM" Key="Software\it-an-der-bar\ClipCloak" Name="StartMenuShortcut"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="5B1F4CF9-6F21-4428-BEDE-2954BB9F8473">
        <Shortcut Id="DesktopShortcut" Name="ClipCloak"
                  Description="Redact, anonymise or pseudonymise clipboard contents"
                  Target="[INSTALLFOLDER]clipcloak.exe" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKLM" Key="Software\it-an-der-bar\ClipCloak" Name="DesktopShortcut"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.AppDir)\**" />
    </ComponentGroup>

    <ComponentGroup Id="NerFiles" Directory="NERFOLDER">
      <Files Include="$(var.NerDir)\**" />
    </ComponentGroup>

    <Feature Id="Main" Title="ClipCloak" Level="1" AllowAbsent="no" ConfigurableDirectory="INSTALLFOLDER"
             Description="The program and its start menu entry.">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="InstallInfo" />
      <ComponentRef Id="PolicyFolder" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <Feature Id="NER" Title="NER plugin" Level="1"
             Description="Finds names of people and companies (spaCy, German and English models). Runs locally.">
      <ComponentGroupRef Id="NerFiles" />
    </Feature>

    <Feature Id="Autostart" Title="Start with Windows" Level="1"
             Description="Start ClipCloak for every user at logon.">
      <Level Value="0" Condition="AUTOSTART = &quot;0&quot;" />
      <ComponentRef Id="Autostart" />
    </Feature>

    <Feature Id="DesktopShortcut" Title="Desktop shortcut" Level="1000"
             Description="Shortcut on the desktop of all users.">
      <Level Value="1" Condition="DESKTOPSHORTCUT = &quot;1&quot;" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>
  </Package>
</Wix>
